# === FMG migration redirects: old WooCommerce/WordPress URLs → new static site ===
#
# Static export served by Apache at the document root. Next.js does NOT copy dotfiles into
# out/, so scripts/postbuild.mjs copies public/.htaccess → out/.htaccess after every build.
#
# IMPORTANT: if the Plesk host already has an .htaccess (SSL / clean-URL rules), MERGE these
# RewriteRules into it instead of overwriting that file.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- WooCommerce product categories: /product-category/<slug>/ → /products/<slug>/ ---
  RewriteRule ^product-category/thermography/?$                /products/thermography/          [R=301,L,NC]
  RewriteRule ^product-category/corona[_-]ultrasonic/?$        /products/corona-ultrasonic/     [R=301,L,NC]
  RewriteRule ^product-category/partial[_-]discharge/?$        /products/partial-discharge/     [R=301,L,NC]
  RewriteRule ^product-category/cable[_-]fault[_-]detection/?$ /products/cable-fault-detection/ [R=301,L,NC]
  RewriteRule ^product-category/hot[_-]?line[_-]equipment/?$   /products/hotline-equipment/     [R=301,L,NC]
  RewriteRule ^product-category/other[_-]equipment/?$          /products/other-equipment/       [R=301,L,NC]
  # Old plural / suffixed WooCommerce category slugs still ranking in Search Console
  RewriteRule ^product-category/hot[_-]?line[_-]?equipments?/?$ /products/hotline-equipment/     [R=301,L,NC]
  RewriteRule ^product-category/thermography[_-]irtc/?$        /products/thermography/          [R=301,L,NC]
  RewriteRule ^product-category/corona/?$                      /products/corona-ultrasonic/     [R=301,L,NC]
  RewriteRule ^product-category/                               /products/                       [R=301,L,NC]
  RewriteRule ^product-tag/                                    /products/                       [R=301,L,NC]

  # --- Legacy /category/<slug>/ base (older, shorter slugs) → new product categories ---
  RewriteRule ^category/(corona|ultrasonic|corona[_-]?ultrasonic)/?$    /products/corona-ultrasonic/     [R=301,L,NC]
  RewriteRule ^category/(thermo|thermography|thermovision)/?$           /products/thermography/          [R=301,L,NC]
  RewriteRule ^category/(pd|partial[_-]?discharge)/?$                   /products/partial-discharge/     [R=301,L,NC]
  RewriteRule ^category/(cable|cable[_-]?fault[_-]?detection)/?$        /products/cable-fault-detection/ [R=301,L,NC]
  RewriteRule ^category/(hotline|hot[_-]?line|hotline[_-]?equipment)/?$ /products/hotline-equipment/     [R=301,L,NC]
  # Any other legacy /category/ archive → products listing (no hard 404s)
  RewriteRule ^category/                                                /products/                       [R=301,L,NC]

  # --- English pages (the new site is Persian-only) → Persian equivalents ---
  RewriteRule ^en/about-us/?$    /about/    [R=301,L,NC]
  RewriteRule ^en/contact.*$     /contact/  [R=301,L,NC]
  RewriteRule ^en/?$             /          [R=301,L,NC]
  RewriteRule ^en/               /          [R=301,L,NC]

  # --- Removed WooCommerce shop/account pages → relevant new pages ---
  RewriteRule ^shop/?$                           /products/ [R=301,L,NC]
  RewriteRule ^(cart|checkout|my-account)(/.*)?$ /          [R=301,L,NC]
  RewriteRule ^refund[_-]returns/?$              /          [R=301,L,NC]

  # --- Legacy static WordPress pages → current equivalents (from Search Console 404s) ---
  RewriteRule ^our-contacts/?$                   /contact/  [R=301,L,NC]
  RewriteRule ^about[_-]?us/?$                   /about/    [R=301,L,NC]
  RewriteRule ^articles-and-training/?$          /blog/     [R=301,L,NC]
  RewriteRule ^مقالات/?$                         /blog/     [R=301,L,NC]
  RewriteRule ^author/[^/]+/?$                   /          [R=301,L,NC]
  RewriteRule ^index\.php/?$                     /          [R=301,L,NC]

  # --- Old WordPress media (/wp-content/uploads/…) — the WP tree is gone from the static site.
  #     Map datasheets we still host to their new /media/ path; 410-Gone the rest so leftover
  #     old asset URLs return a clean signal instead of the host's Passenger 500. ---

  # High-value spec-sheet PDFs that still rank in Search Console for their OWN product's brand
  # queries (e.g. "hotfind": 333 impressions/90d, position 7.6, CTR 0.3% — the single largest
  # impression source on the whole site) instead of the real product page. A bare PDF result has
  # no compelling title/description, so almost nobody clicks it. Send these specific old URLs to
  # the product page (which links the same PDF for download) so the SERP snippet — once Google
  # recrawls — is the rich product page instead. Exact matches only; ordered before the generic
  # PDF rule below so they take precedence, and MUST come before it in this file.
  RewriteRule ^wp-content/uploads/[0-9]{4}/[0-9]{2}/SATIR-Hotfind-S-spec\.pdf$ /product/thermographic-camera-hotfind-s/ [R=301,L,NC]
  RewriteRule ^wp-content/uploads/[0-9]{4}/[0-9]{2}/SATIR-D600\.pdf$          /product/thermographic-camera-d-600/      [R=301,L,NC]
  RewriteRule ^wp-content/uploads/[0-9]{4}/[0-9]{2}/SATIR-G96-Plus-_-Performance-Thermal-Imaging-spec\.pdf$ /product/thermographic-camera-g96/ [R=301,L,NC]

  # Batch 2 (GSC 90-day snapshot, 2026-09-12 FULL run): four more spec-sheet PDFs ranking
  # instead of their product page — same pattern as the two rules above. "thermal-imaging-
  # camera-ti175-ti395.pdf" is shared by two product pages (TI175/TI395); GSC's query,page
  # breakdown shows the "ti175" query against this URL, so it targets the TI175 page (the
  # base/cheaper model) — the TI395 page still links the same PDF for download.
  RewriteRule ^wp-content/uploads/[0-9]{4}/[0-9]{2}/XDP-II\.pdf$                         /product/%D8%AF%D8%B3%D8%AA%DA%AF%D8%A7%D9%87-ndb-xdp-ii/ [R=301,L,NC]
  RewriteRule ^wp-content/uploads/[0-9]{4}/[0-9]{2}/ULD-40-brochure-ENG\.pdf$            /product/ultrasonic-device-uld40/                         [R=301,L,NC]
  RewriteRule ^wp-content/uploads/[0-9]{4}/[0-9]{2}/Megger-digiPHONE2\.pdf$              /product/digiphone/                                       [R=301,L,NC]
  RewriteRule ^wp-content/uploads/[0-9]{4}/[0-9]{2}/thermal-imaging-camera-ti175-ti395\.pdf$ /product/thermographic-camera-ti175/                   [R=301,L,NC]

  #     Map ANY other old wp-content/uploads/YYYY/MM/<file>.pdf → new flat /media/ path (files we host).
  RewriteRule ^wp-content/uploads/[0-9]{4}/[0-9]{2}/(.+\.pdf)$ /media/products/documents/$1 [R=301,L,NC]
  RewriteRule ^wp-content/ - [G,L,NC]

  # --- Renamed article slugs: old Persian URL → new English URL (mod_rewrite matches the
  #     percent-decoded UTF-8 path, so the Persian literal below is correct) ---
  RewriteRule ^blog/تخلیه-جزئی-چیست/?$ /blog/what-is-partial-discharge/ [R=301,L]

  # --- SATIR i640 case studies moved from the D600 product key to their own camera page ---
  RewriteRule ^case-studies/thermographic-camera-d-600/?$ /case-studies/satir-i640/ [R=301,L,NC]

  # --- Safety net: old product URLs that no longer exist → products listing ---
  # Fires ONLY when the requested path is not a real file/dir, so valid new /product/<slug>/
  # pages are served normally and never redirected. Replace with exact per-product 301s once
  # the 404 list is known (Search Console → Pages → "Not found (404)").
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^product/.+ /products/ [R=301,L,NC]

  # --- Canonical trailing slash (keep LAST) — fixes the host's 500 on slash-less URLs ---
  # This is a static export: every page is a directory (e.g. training/index.html). The Plesk
  # host has Phusion Passenger enabled, which hijacks any request that is NOT a static file
  # and tries to boot a (non-existent) Node app → 500. A slashed request (/training/) resolves
  # to the static index and never reaches Passenger; a slash-less one (/training) does. So
  # redirect slash-less, extensionless, non-file requests to the canonical slashed URL first.
  # Proper permanent fix is server-side: disable Node.js/Passenger for this domain in Plesk —
  # this site serves only static files and needs no application server.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]{1,8}$
  RewriteRule ^(.+)$ /$1/ [R=301,L]
</IfModule>
